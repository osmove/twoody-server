# twoody-server runtime env.
#
# Suggested install path: /etc/twoody-server.env (chmod 0600, owned by
# root). Referenced by `scripts/twoody-server.service`.
#
# Fill in the values that apply to your deployment; leave the rest
# blank. Comments below explain which subsystem each block unlocks.

# ── Network ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── In-process bridge executor ───────────────────────────────────────
# Set to 1 on headless Linux deployments where no external Mac Bridge
# worker will long-poll /bridge/tasks/next. Runs `search`, `read`,
# `list_folders`, `list_dir`, and `llm_infer` in the same Node
# process. Off by default for backward compatibility with installs
# that still pair with a Mac.
TWOODY_SELF_BRIDGE=1

# Folders the bridge is allowed to search/read. Accepts:
#   /path1:/path2              (colon-separated)
#   /path1,/path2              (comma-separated)
#   ["/path1","/path2"]        (JSON array)
# Optional `Name=` prefix gives a folder a friendly label:
#   Documents=/home/pi/Documents:Media=/srv/share
TWOODY_BRIDGE_FOLDERS=Documents=/home/pi/Documents

# ── Local LLM (Ollama / mlx-lm / vLLM / …) ───────────────────────────
# OpenAI-compatible /v1 root. Ollama listens on 11434 by default;
# mlx-lm on 8080. Leave empty to disable the local LLM path.
BRIDGE_LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434/v1

# ── Home Assistant integration ───────────────────────────────────────
# When set, the `smart_home` tool calls these endpoints. Token is a
# long-lived access token created in HA → Profile → Long-lived tokens.
# HOME_ASSISTANT_URL=http://192.168.1.89:8123
# HOME_ASSISTANT_TOKEN=...

# ── Upstream bridge client ───────────────────────────────────────────
# When TWOODY_BACKEND_URL + TWOODY_USER_TOKEN are set, this server
# also long-polls an upstream Twoody backend (the managed cloud at
# api.twoody.com, or a self-hosted Rails) and claims smart_home_proxy
# / search / read / llm_infer / list_* tasks routed to the user's LAN.
# Used by mobile clients that talk to api.twoody.com but need a
# LAN-side worker for local-only resources (Home Assistant, files,
# private LLM). Leave blank when this server is only used directly by
# LAN clients (CLI/Desktop pointing at this host).
# TWOODY_BACKEND_URL=https://api.twoody.com
# TWOODY_USER_TOKEN=...
# TWOODY_BRIDGE_DEVICE_NICKNAME=twoody-pi
#
# Local models lent to that backend (llm_infer). Several runtimes may be
# listed; a model goes to the one that holds it. The default model is
# what runs when an app asks for "the local model" without naming one.
# BRIDGE_LOCAL_LLM_ENDPOINTS=http://127.0.0.1:11434/v1,http://127.0.0.1:8080/v1
# BRIDGE_LOCAL_LLM_MODEL=qwen3:8b

# ── Bonjour / mDNS ───────────────────────────────────────────────────
# Advertise this server as `_twoody._tcp` on the LAN so the mobile and
# desktop apps can discover it without typing an IP. Set to 1 to opt
# out (CI, Docker bridge networks).
# TWOODY_BONJOUR_DISABLED=

# ── Spotify Web API ──────────────────────────────────────────────────
# When all three are set, the local `spotify` tool (play / pause /
# next / previous / volume / search_and_play) actually drives the
# user's Spotify account. Obtain via the Authorization Code flow once
# (one-time browser dance on developer.spotify.com). SPOTIFY_DEVICE_ID
# is optional — Spotify Connect device the playback target pins to;
# omit to use the "active" device on the account.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_DEVICE_ID=

# ── Local STT (whisper.cpp) ──────────────────────────────────────────
# Paths to the whisper-cli binary + a ggml model. Advertised as
# `audio-transcribe-provider` when both files exist; missing →
# /audio/transcriptions and the `transcribe` bridge kind both return
# 503 `whisper_not_configured`.
# WHISPER_BIN=/home/pi/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/home/pi/whisper.cpp/models/ggml-base.bin
# WHISPER_THREADS=4

# ── Local OCR (tesseract) ────────────────────────────────────────────
# Tesseract binary + default language. Advertised as `ocr-provider`
# when the binary exists. Install with:
#   apt install tesseract-ocr tesseract-ocr-fra tesseract-ocr-eng
# TESSERACT_BIN=/usr/bin/tesseract
# TESSERACT_LANG=fra+eng
