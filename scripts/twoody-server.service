[Unit]
Description=Twoody Server (local-first Twoody backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/twoody-server
EnvironmentFile=/etc/twoody-server.env
ExecStart=/usr/bin/node /opt/twoody-server/dist/index.js
Restart=always
RestartSec=5
# Exit 78: TWOODY_DATA_ENCRYPTION=require and the data folder is not on an
# encrypted volume yet (not opened since the boot): no restart loop, it
# starts once the volume is opened (docs/encrypted-storage.md).
RestartPreventExitStatus=78
# The built-in model engine (llama-server, and the model process it starts)
# runs in this unit's control group: stopping the service stops it too,
# even if the server did not get to (docs/builtin-runtime-design.md §3).
KillMode=control-group
TimeoutStopSec=10

# The database, the setup token and the session keys live under the
# user's home (DATA_DIR in src/db.ts, or wherever TWOODY_DATA_DIR
# points), and so do the built-in engine's runtime and models
# (DATA_DIR/runtime, DATA_DIR/models). Everything else this service can reach is narrowed down:
# it answers HTTP, reads the folders it was given, and talks to a
# model runtime on this machine. It has no business writing anywhere
# else, and a bug that tried would be stopped here rather than found
# later.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/.twoody /home/pi/.twoody-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# Documents the server is allowed to index are read through
# ProtectHome=read-only; widen ReadWritePaths only if you point
# TWOODY_DATA_DIR somewhere else.

[Install]
WantedBy=multi-user.target
