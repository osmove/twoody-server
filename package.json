    "openapi": "npm run build && node scripts/write-openapi.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.28.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
