{
  "name": "twoody-server",
  "version": "0.2.0",
  "description": "Twoody server — self-hosted backend (BSL 1.1)",
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "twoody-server": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "openapi": "npm run build && node scripts/write-openapi.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.31.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
