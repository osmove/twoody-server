{
  "name": "twoody-server",
  "version": "0.2.0",
  "description": "Twoody Server: the self-hosted, local-first Twoody backend for a Raspberry Pi, a NAS or a server, without the desktop app",
  "keywords": [
    "twoody",
    "assistant",
    "local-llm",
    "ollama",
    "llama.cpp",
    "self-hosted",
    "raspberry-pi",
    "private-ai"
  ],
  "homepage": "https://twoody.com",
  "bugs": {
    "email": "support@twoody.com"
  },
  "author": "Osmove",
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./builtin": "./dist/builtin/index.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "twoody-server": "./bin/twoody-server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "openapi": "npm run build && node scripts/write-openapi.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:builtin": "node scripts/smoke-builtin.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.31.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.2.4",
    "mailparser": "^3.9.34",
    "nodemailer": "^10.0.14",
    "unpdf": "^1.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
