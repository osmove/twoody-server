{
  "name": "@twoody/local-server",
  "version": "0.1.0",
  "description": "Twoody local server — self-hosted backend (BSL 1.1)",
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch src/index.ts",
    "start": "node dist/index.js",
