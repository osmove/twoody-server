{
  "name": "twoody-server",
  "version": "0.2.0",
  "description": "Twoody server — self-hosted backend (BSL 1.1)",
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "twoody-server": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "openapi": "npm run build && node scripts/write-openapi.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "@fastify/websocket": "^10.0.1",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.3.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.28.0",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
